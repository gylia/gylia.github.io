{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{/* One flat sitemap at the root. Hugo's default is an index pointing at
     /en/sitemap.xml, which lists root URLs from an /en/ path and so breaks
     the rule that a sitemap may only list URLs at or below its own directory. */}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{{ range . }}
  {{ range .Pages }}
    {{ if and .Permalink (ne .Kind "taxonomy") (ne .Kind "term") }}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>{{ end }}
  </url>
    {{ end }}
  {{ end }}
{{ end }}
</urlset>
